# MySQL connection string, e.g. mysql://user:password@localhost:3306/meeronbi
DATABASE_URL="mysql://root:password@localhost:3306/meeronbi"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# This app's own real origin (no protocol, no trailing slash) — narrows
# next.config.mjs's Server Actions `allowedOrigins` away from a wildcard.
# Optional locally (falls back to localhost:3000); set this to the real
# domain before deploying anywhere public.
NEXT_PUBLIC_APP_ORIGIN="localhost:3000"

# Seed script: initial admin login created by prisma/seed.ts
SEED_ADMIN_EMAIL="admin@meeronbi.org"
SEED_ADMIN_PASSWORD="testing@123"

# Seed script: super-admin login (MeeronBi team — every facility, no
# facility-scoping applies). Also approves/rejects researcher access
# requests at /admin/researchers.
SEED_SUPER_ADMIN_EMAIL="team@meeronbi.org"
SEED_SUPER_ADMIN_PASSWORD="testing@123"

# Seed script also creates one fully-filled-out demo patient (all 7 tabs
# marked Complete) plus a patient-portal login for her, so you can see what
# a finished record looks like from both the staff and patient side.
SEED_DEMO_PATIENT_EMAIL="tombi.demo@meeronbi.org"
SEED_DEMO_PATIENT_PASSWORD="testing@123"
