// MeeronBi Antenatal Care — Prisma schema (MySQL). Each tab is one row per
// patient with a flexible `data Json` column plus a DRAFT/COMPLETE status.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN // full access across every facility
  ADMIN // hospital staff, scoped to their own facility
  PATIENT // read-only access to their own record
  RESEARCHER // analytics-only access once APPROVED
}

enum ResearcherStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RecordStatus {
  DRAFT
  COMPLETE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  COMPLETE
  APPROVE
  REJECT
  PORTAL_ACCESS_SET
  PORTAL_ACCESS_REVOKED
  ANALYTICS_QUERY
}

// The tenant boundary — every Patient/User/TabFieldPreference belongs to one Facility.
model Facility {
  id          String   @id @default(cuid())
  name        String
  // Stable URL-safe identifier, e.g. for the public trends page.
  slug        String   @unique
  stateCode   String?
  countryCode String   @default("IN") // ISO 3166-1 alpha-2
  // Date/measurement-unit formatting only — see src/domain/locale.ts. Not full i18n.
  locale      String   @default("en-IN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users               User[]
  patients            Patient[]
  tabFieldPreferences TabFieldPreference[]
  auditLogs           AuditLog[]

  @@map("facilities")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  // Null until an invited user sets one, or for an OAuth-only account.
  passwordHash      String?
  name              String?
  role              Role      @default(ADMIN)
  createdAt         DateTime  @default(now())
  lastLoginAt       DateTime?
  emailVerifiedAt   DateTime?
  passwordChangedAt DateTime?

  // SUPER_ADMIN/RESEARCHER are anchored to a seeded "HQ" facility as an administrative home only.
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id])

  // If role === PATIENT, links this login to their one patient record.
  patient      Patient?  @relation("PatientAccount")

  createdPatients Patient[] @relation("CreatedBy")

  // If role === RESEARCHER, carries their approval status/request details.
  researcherProfile ResearcherProfile?

  reviewedResearchers ResearcherProfile[] @relation("ReviewedBy")

  auditLogs AuditLog[]

  credentialTokens CredentialToken[]

  oauthAccounts OAuthAccount[]

  @@index([facilityId])
  @@map("users")
}

// We authenticate with Google but never call Google APIs on the user's behalf, so no
// access/refresh tokens are stored — fewer secrets at rest.
model OAuthAccount {
  id                String   @id @default(cuid())
  provider          String
  // Google's stable `sub`. Linking on this, not the mutable email, is what keeps a
  // later email change from silently re-pointing an identity at a different account.
  providerAccountId String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// One per RESEARCHER-role User — the request-and-approval record for the researcher-access flow.
model ResearcherProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status ResearcherStatus @default(PENDING)
  institution String
  purpose     String @db.Text

  requestedAt DateTime  @default(now())
  reviewedAt  DateTime?
  reviewedBy   User?   @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewNote   String? @db.Text

  @@map("researcher_profiles")
}

model Patient {
  id          String   @id @default(cuid())
  // Unique per facility, not globally.
  mrn         String?  // "4. CR No./MRD"
  fullName    String // "1. Full Name"
  surname     String? // "2. Surname"
  contactNo   String? // "5. Contact No."
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id])

  createdById String
  createdBy   User     @relation("CreatedBy", fields: [createdById], references: [id])

  // Optional linked login for the patient portal.
  userId      String?  @unique
  user        User?    @relation("PatientAccount", fields: [userId], references: [id])

  personal      PersonalInfo?
  history       ObstetricHistory?
  investigation Investigation?
  ultrasound    Ultrasound?
  delivery      Delivery?
  robson        RobsonClassification?
  treatments    Treatment?

  @@unique([facilityId, mrn])
  @@index([facilityId])
  @@index([fullName])
  @@map("patients")
}

// Tab 1 — Personal (fields 1-24)
model PersonalInfo {
  id        String       @id @default(cuid())
  patientId String       @unique
  patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status    RecordStatus @default(DRAFT)
  data      Json
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("personal_info")
}

// Tab 2 — History (fields 25-41, incl. repeating Obstetric History G1-G6)
model ObstetricHistory {
  id        String       @id @default(cuid())
  patientId String       @unique
  patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status    RecordStatus @default(DRAFT)
  data      Json
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("obstetric_history")
}

// Tab 3 — Investigation (fields 42-80)
model Investigation {
  id        String       @id @default(cuid())
  patientId String       @unique
  patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status    RecordStatus @default(DRAFT)
  data      Json
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("investigations")
}

// Tab 4 — Ultrasound (fields 81-116)
model Ultrasound {
  id        String       @id @default(cuid())
  patientId String       @unique
  patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status    RecordStatus @default(DRAFT)
  data      Json
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("ultrasounds")
}

// Tab 5 — Delivery (fields 117-137)
model Delivery {
  id            String       @id @default(cuid())
  patientId     String       @unique
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status        RecordStatus @default(DRAFT)

  // Denormalized for public trend aggregation.
  admissionType String? // "Emergency" | "Routine"
  deliveryMode  String? // "Vaginal" | "Caesarean" | "Instrumental"
  babyWeightKg  Float?

  data          Json
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("deliveries")
}

// Tab 6 — Robson classification
model RobsonClassification {
  id          String       @id @default(cuid())
  patientId   String       @unique
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status      RecordStatus @default(DRAFT)

  // Denormalized for trend aggregation.
  groupNumber Int? // 1-10

  data        Json
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("robson_classifications")
}

// Tab 7 — Treatments (repeating visit measurements + medication courses)
model Treatment {
  id        String       @id @default(cuid())
  patientId String       @unique
  patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status    RecordStatus @default(DRAFT)
  data      Json
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("treatments")
}

// Per-tab, per-facility "which fields does this hospital collect" — see src/domain/fieldVisibility.ts.
model TabFieldPreference {
  facilityId        String
  facility          Facility @relation(fields: [facilityId], references: [id])
  tabKey            String
  enabledFieldNames Json
  updatedAt         DateTime @updatedAt

  @@id([facilityId, tabKey])
  @@map("tab_field_preferences")
}

// Per-entity-change audit trail — a compliance requirement for medical data (researcher-query
// logging, "who touched this record"). Always written inside the same prisma.$transaction as the
// mutation it records (see writeAuditLog in src/server/http/audit.ts), so audit and mutation
// succeed-or-fail together — a swallowed audit write on a successful mutation is exactly the class
// of bug this pattern exists to prevent.
model AuditLog {
  id          String      @id @default(cuid())
  facilityId  String
  facility    Facility    @relation(fields: [facilityId], references: [id])
  actorUserId String?
  actor       User?       @relation(fields: [actorUserId], references: [id])
  action      AuditAction
  entityType  String // "Patient" | "TabRecord" | "User" | "ResearcherProfile" | "TabFieldPreference" | "Analytics"
  entityId    String
  before      Json?
  after       Json?
  requestId   String?
  createdAt   DateTime    @default(now())

  @@index([facilityId, entityType, entityId])
  @@map("audit_logs")
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

// Transactional outbox: a row is written inside the same transaction as the change
// it announces, so an email can never be lost to a rollback or sent for one.
model EmailOutbox {
  id             String      @id @default(cuid())
  template       String
  toEmail        String
  // Rendered at send time, not enqueue time, so fixing a template also fixes queued mail.
  payload        Json
  status         EmailStatus @default(PENDING)
  attempts       Int         @default(0)
  nextAttemptAt  DateTime    @default(now())
  // Worker run id; a claim marker, so a second worker process stays safe later.
  claimedBy      String?
  claimedAt      DateTime?
  lastError      String?     @db.Text
  sentAt         DateTime?
  // e.g. "researcher-approved:<userId>" — a double-clicked button enqueues once.
  idempotencyKey String?     @unique
  createdAt      DateTime    @default(now())

  @@index([status, nextAttemptAt])
  @@map("email_outbox")
}

enum CredentialTokenPurpose {
  EMAIL_VERIFICATION // self-serve researcher signup proving their address
  ACCOUNT_INVITE     // a provisioned user choosing their first password
  PASSWORD_RESET     // self-serve reset
}

// Single-use credential tokens. Only the sha256 hash is stored, for the same reason
// passwords are hashed: a database leak must not yield usable links.
model CredentialToken {
  id         String                 @id @default(cuid())
  tokenHash  String                 @unique
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    CredentialTokenPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime               @default(now())

  @@index([userId, purpose])
  @@map("credential_tokens")
}
